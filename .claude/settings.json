{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/no-merge-guard.sh\"",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh merge-queue *)",
      "Bash(gh alias *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main)",
      "mcp__github__merge_pull_request"
    ]
  }
}
