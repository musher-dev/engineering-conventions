# ============================================================
# Dev Container Environment — GENERATED. Do not edit.
# ============================================================
# Rendered from .devcontainer/env.schema.yaml by `task env:render`.
# `repo env check` fails when the two disagree, so edit the schema.
#
# On first build the host-side initializeCommand copies this file to
# .devcontainer/.env (gitignored), which feeds both Docker Compose and the
# container itself. `task env:setup` fills in what is missing;
# `task env:doctor` says what that is.
#
# Three states: `VAR=value` is a local default, `VAR=` must be filled in,
# and `# VAR=value` is an optional override — uncomment to enable.
# ============================================================


# === Service Profiles =====================================================
# Comma-separated list of optional stacks to start. Empty means only the
# always-on stacks (postgres). `task env:setup` offers these as a menu.
# Allowed: redis, minio, registry, azimutt, observability
COMPOSE_PROFILES=


# === PostgreSQL ===========================================================
# Superuser the always-on Postgres stack is initialised with.
POSTGRES_USER=postgres

# Dev-only password for POSTGRES_USER. Never a real credential.
POSTGRES_PASSWORD=postgres

# Database created on first start of the Postgres stack.
POSTGRES_DB=app


# === MinIO (project S3 storage) ===========================================
# Root user of the project MinIO stack.
MINIO_ROOT_USER=minioadmin

# Root password of the project MinIO stack. Dev-only.
MINIO_ROOT_PASSWORD=minioadmin


# === MinIO (observability stack) ==========================================
# Root user of the MinIO instance Tempo and Loki store blocks in. Those two
# configs are native YAML with no env interpolation, so they carry the value
# literally; `mirrored_in` is what keeps them in step (ENV-05).
MINIO_OBS_ROOT_USER=minioadmin

# Root password for that MinIO instance, mirrored the same way.
MINIO_OBS_ROOT_PASSWORD=minioadmin
