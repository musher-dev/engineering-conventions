// Dev container for musher-dev/engineering-conventions.
// Which tier a tool belongs in: docs/repository.md → "Toolchain".
{
  "name": "Engineering Conventions",
  // The Dockerfile bakes mise and nothing else; the Features below layer on
  // top of it. Context is emptied by .dockerignore.
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/git:1": {},
    // gh is a Feature rather than a mise pin so it exists before post-create,
    // and still exists in a container whose `mise install` failed.
    "ghcr.io/devcontainers/features/github-cli:1": { "version": "2.101.0" }
  },

  "containerUser": "vscode",
  "remoteUser": "vscode",

  "init": true,
  "shutdownAction": "stopContainer",

  // Named volumes so a rebuild costs neither a re-auth nor agent history.
  "mounts": [
    "source=musher-${devcontainerId}-gh-config,target=/home/vscode/.config/gh,type=volume",
    "source=musher-${devcontainerId}-claude-config,target=/home/vscode/.claude,type=volume",
    "source=musher-${devcontainerId}-codex-config,target=/home/vscode/.codex,type=volume"
  ],

  "containerEnv": {
    // Point mise at the workspace manifest (it lives under .devcontainer/, not
    // the repo root) and auto-trust it so `mise install` runs without a prompt.
    "MISE_GLOBAL_CONFIG_FILE": "${containerWorkspaceFolder}/.devcontainer/mise.toml",
    "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}",

    "PYTHONDONTWRITEBYTECODE": "1",
    "UV_LINK_MODE": "copy",
    "XDG_CACHE_HOME": "/home/vscode/.cache",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv",
    "NPM_CONFIG_CACHE": "/home/vscode/.cache/npm"
  },

  "remoteEnv": {
    // mise shims (every pinned CLI) + ~/.local/bin (Claude Code). mise itself
    // is baked into /usr/local/bin and is already on PATH.
    "PATH": "/home/vscode/.local/share/mise/shims:/home/vscode/.local/bin:${containerEnv:PATH}"
  },

  "waitFor": "postCreateCommand",
  // Line endings are enforced repo-wide by .gitattributes (`* text=auto eol=lf`),
  // so scripts arrive with LF on every platform and need no CRLF fixup.
  "postCreateCommand": ["bash", ".devcontainer/scripts/post-create.sh"],

  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "tsandall.opa",
        "chrischinchilla.vale-vscode",
        "DavidAnson.vscode-markdownlint",
        "tamasfe.even-better-toml",
        "timonwong.shellcheck",
        "github.vscode-github-actions",
        "charliermarsh.ruff"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.rulers": [80, 120],
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,

        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash" },
          "zsh": { "path": "/bin/zsh" }
        },

        // The same configs `task` passes by explicit path, so the editor and
        // the gates agree.
        "markdownlint.configFile": ".config/markdown/markdownlint.jsonc",
        "vale.valeCLI.config": "${workspaceFolder}/.config/markdown/vale.ini",
        "opa.dependency_paths.opa": "/home/vscode/.local/share/mise/shims/opa",
        "opa.dependency_paths.regal": "/home/vscode/.local/share/mise/shims/regal",

        // Authoring-time validation against the schemas the gates use
        // (`task schemas:validate`).
        "yaml.schemas": {
          "./engineering-conventions/checks/schemas/terminology.schema.json": [
            "engineering-conventions/terminology/**/*.yml"
          ],
          "./engineering-conventions/checks/schemas/profile.schema.json": [
            "engineering-conventions/profiles/*.yml"
          ],
          "./engineering-conventions/checks/schemas/families.schema.json": [
            "engineering-conventions/conventions/families.yml"
          ],
          "./engineering-conventions/checks/schemas/conventions-declaration.schema.json": [
            ".repo/conventions.yaml",
            "engineering-conventions/examples/consumer/.repo/conventions.yaml"
          ]
        },

        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },
        "[rego]": {
          "editor.defaultFormatter": "tsandall.opa"
        }
      }
    }
  }
}
