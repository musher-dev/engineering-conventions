# Build outputs. `task bundle:build` writes the release bundle here; nothing
# under dist/ is ever committed.
/dist/
.cache/

# uv (engineering-conventions/ is a uv project)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# pytest-cov's data file (`task cli:test`)
.coverage

# Personal git-hook overrides (auto-merged by lefthook)
.config/lefthook-local.yml

# Claude local preferences and runtime state
.claude/settings.local.json
.claude/scheduled_tasks.lock
