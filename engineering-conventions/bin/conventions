#!/bin/sh
# conventions: check a repository against this release of
# musher-dev/engineering-conventions.
#
# Shipped in the release bundle, so installing a release with mise puts it on
# PATH:
#
#   .config/mise/config.toml   [tools] "github:musher-dev/engineering-conventions" = "X.Y.Z"
#   then                       conventions check
#
# It needs only POSIX sh, git, and sha256sum, shasum or openssl to hash
# vendored copies. conftest, jq, Vale and Spectral come through
# `mise exec` at the versions below, which move with this release, so the
# bundle pin is the only pin. Without mise it uses them from PATH.
#
# `check` prints a report for a person by default and a JSON array of
# findings with --output json; any other format is conftest's own. The report
# goes to stdout; progress goes to stderr, and only on a terminal.
#
# The repository's actual name, which REPO-07 compares with the declared one,
# comes from --repository or CONVENTIONS_REPOSITORY, else GITHUB_REPOSITORY
# when the checked directory is GITHUB_WORKSPACE, else the origin remote
# when it is a work-tree root, else nowhere (EC-0010).
#
# Usage:
#   conventions check [--fail-on error|warning] [--output text|json|FORMAT] [--repository NAME] [-C DIR]
#   conventions prose [-C DIR] [PATH...]
#   conventions openapi [-C DIR] [--ruleset FILE] [FILE...]
#   conventions version
set -eu

# Lockstep with .config/mise/config.toml (.claude/rules/toolchain-pins.md).
CONFTEST_VERSION=0.70.1
VALE_VERSION=3.22.0
JQ_VERSION=1.8.2
SPECTRAL_VERSION=6.16.3

bundle=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

die() {
  printf 'conventions: %s\n' "$*" >&2
  exit 2
}

usage() {
  sed -n 's/^#   conventions/conventions/p' "$0" >&2
  exit 2
}

# tool NAME BACKEND VERSION ARGS...: run NAME at VERSION through mise, or the
# NAME on PATH when mise is absent or CONVENTIONS_NO_MISE is set.
tool() {
  name=$1 backend=$2 version=$3
  shift 3
  if [ -z "${CONVENTIONS_NO_MISE:-}" ] && command -v mise > /dev/null 2>&1; then
    mise exec "${backend}@${version}" -- "${name}" "$@"
  elif command -v "${name}" > /dev/null 2>&1; then
    "${name}" "$@"
  else
    die "${name} is not installed: install mise (https://mise.jdx.dev), or put ${name} ${version} on PATH"
  fi
}

# The repository to check: the -C directory exactly, or else the work tree
# the current directory is in, so the command works from any subdirectory.
find_root() {
  if [ -n "${given}" ]; then
    root=$(pwd)
  else
    root=$(git rev-parse --show-toplevel 2> /dev/null || pwd)
  fi
}

# Whether the checked directory is the top of a git work tree, rather than a
# directory inside one (a fixture, a vendored copy) or no work tree at all.
is_work_tree_root() {
  [ "$(git -C "${root}" rev-parse --show-toplevel 2> /dev/null || true)" = "${root}" ]
}

# The repository's files: tracked and untracked-but-not-ignored when it is a
# git work tree, every file otherwise. One path per line, sorted.
list_files() {
  if is_work_tree_root; then
    git -C "${root}" -c core.quotePath=false ls-files --cached --others --exclude-standard
  else
    (cd "${root}" && find . -type f ! -path './.git/*' | sed 's|^\./||')
  fi | while IFS= read -r file; do
    # The index still lists a file deleted from the work tree.
    if [ -f "${root}/${file}" ]; then printf '%s\n' "${file}"; fi
  done | LC_ALL=C sort -u
}

# The last path segment of a remote URL, in any of its forms:
# https://host/owner/name.git, git@host:owner/name.git, ssh://git@host/owner/name.
remote_name() {
  url=${1%/}
  url=${url%.git}
  url=${url##*/}
  printf '%s\n' "${url##*:}"
}

# The repository's actual name (EC-0010), or empty when nothing says it. The
# GitHub and origin sources are trusted only for the directory they describe,
# so checking a fixture or a subdirectory never borrows the enclosing name.
repository_name() {
  name=${repository:-${CONVENTIONS_REPOSITORY:-}}
  if [ -z "${name}" ] && [ -n "${GITHUB_REPOSITORY:-}" ] && [ -n "${GITHUB_WORKSPACE:-}" ] &&
    [ "$(cd -- "${GITHUB_WORKSPACE}" 2> /dev/null && pwd -P)" = "$(cd -- "${root}" && pwd -P)" ]; then
    name=${GITHUB_REPOSITORY##*/}
  fi
  if [ -z "${name}" ] && is_work_tree_root; then
    name=$(remote_name "$(git -C "${root}" remote get-url origin 2> /dev/null || true)")
  fi
  # Only a plain GitHub name is passed on, so it needs no JSON escaping.
  case ${name} in
    '' | . | .. | *[!A-Za-z0-9._-]*) ;;
    *) printf '%s\n' "${name}" ;;
  esac
}

# What conftest reads: workflows, actions, rulesets, the release-please config
# and release-please manifest, committed's configuration (COMMIT-01), the
# TOML declarations under .repo/ (conventions, outputs, repository identity
# and dependencies), the release record of each vendored copy (DEPS-05), the
# mise configuration ADOPT-09 looks for a pin in (lib/files.rego), a dev
# container's lockfile and the compose stacks beside it (DEVC), and a
# Taskfile at any depth under an OpenTofu directory, where a root keeps the
# Taskfile that names its state key (TOFU-01), and the issue forms, template
# chooser, discussion forms and FUNDING.yml GitHub reads (COMM).
INPUTS='^\.github/workflows/[^/]+\.[Yy][Aa]?[Mm][Ll]$'
INPUTS="${INPUTS}|"'^\.github/actions/.+/action\.ya?ml$'
INPUTS="${INPUTS}|"'^\.github/rulesets/[^/]+\.json$'
INPUTS="${INPUTS}|"'^\.github/release-please/(config|manifest)\.json$'
INPUTS="${INPUTS}|"'^\.config/commits/committed\.toml$'
INPUTS="${INPUTS}|"'^\.repo/(conventions|outputs|repository|dependencies)\.toml$'
INPUTS="${INPUTS}|"'^([^/]+/)?contracts/vendor/[^/]+/[^/]+/release\.json$'
INPUTS="${INPUTS}|"'^(\.?mise|\.config/mise|\.devcontainer/mise)\.toml$'
INPUTS="${INPUTS}|"'^(\.config/mise|mise)/config\.toml$'
INPUTS="${INPUTS}|"'^\.github/dependabot\.ya?ml$'
INPUTS="${INPUTS}|"'^([^/]+/){0,2}[Tt]askfile(\.dist)?\.ya?ml$'
INPUTS="${INPUTS}|"'^([^/]+/){0,2}taskfiles/[^/]+\.ya?ml$'
INPUTS="${INPUTS}|"'^([^/]+/)?(terraform|tofu|opentofu)/(.+/)?[Tt]askfile(\.dist)?\.ya?ml$'
INPUTS="${INPUTS}|"'^(\.config/)?\.?lefthook(-local)?\.ya?ml$'
INPUTS="${INPUTS}|"'^([^/]+/){0,2}env\.schema\.ya?ml$'
INPUTS="${INPUTS}|"'^([^/]+/){0,2}package\.json$'
INPUTS="${INPUTS}|"'^\.config/security/trivyignore\.ya?ml$'
INPUTS="${INPUTS}|"'^\.devcontainer(/[^/]+)?/devcontainer-lock\.json$|^\.devcontainer-lock\.json$'
INPUTS="${INPUTS}|"'^\.devcontainer/(.+/)?(docker-)?compose(\.[^/]+)?\.ya?ml$'
INPUTS="${INPUTS}|"'^\.github/(ISSUE|DISCUSSION)_TEMPLATE/[^/]+\.yml$'
INPUTS="${INPUTS}|"'^\.github/FUNDING\.yml$'

# Files conftest cannot choose a parser for by name, parsed before the check
# with the parser named and added to the inventory (decision 0015):
# devcontainer.json is JSON with comments, and a Dockerfile's name is often
# build.Dockerfile, which conftest reads as an unknown extension.
JSONNET='^\.devcontainer(/[^/]+)?/devcontainer\.json$'
JSONNET="${JSONNET}|"'^\.devcontainer\.json$'
DOCKERFILES='^([^/]+/){0,3}([^/]+\.)?([Dd]ockerfile|[Cc]ontainerfile)(\.[A-Za-z0-9_-]+)?$'
# BuildKit's per-Dockerfile ignore file (build.Dockerfile.dockerignore) is
# named like a Dockerfile but is not one.
NOT_DOCKERFILES='\.dockerignore$'

# Files the checks read as text: agent context, skills and subagents, decision
# records, the .config/ index, CODEOWNERS, the security policy, and the one-line
# and ignore files no parser reads,
# including an ignore file kept in .config/ without its dot (EC-0012). Only
# files up to TEXT_LIMIT bytes are embedded.
TEXTS='(^|/)CLAUDE\.md$'
TEXTS="${TEXTS}|"'^AGENTS\.md$'
TEXTS="${TEXTS}|"'^\.claude/rules/.+\.md$'
TEXTS="${TEXTS}|"'(^|/)\.claude/skills/[^/]+/SKILL\.md$'
TEXTS="${TEXTS}|"'(^|/)\.claude/agents/.+\.md$'
TEXTS="${TEXTS}|"'^\.config/README\.md$'
TEXTS="${TEXTS}|"'(^|/)(decisions|adrs)/.+\.md$'
TEXTS="${TEXTS}|"'(^|/)\.(trivyignore|gitleaksignore|nvmrc|node-version|python-version|tool-versions)$'
TEXTS="${TEXTS}|"'^\.config/(.+/)?(trivyignore|gitleaksignore)$'
# The configuration in .config/ itself, whatever its format, for the files it
# names beside it (CONF-04).
TEXTS="${TEXTS}|"'^\.config/.+\.(jsonc?|ya?ml|toml|ini)$'
# CODEOWNERS and the security policy, wherever GitHub looks for them (COMM).
TEXTS="${TEXTS}|"'^(\.github/|docs/)?CODEOWNERS$'
TEXTS="${TEXTS}|"'^(\.github/|docs/)?[Ss][Ee][Cc][Uu][Rr][Ii][Tt][Yy]\.([Mm][Dd]|[Mm][Aa][Rr][Kk][Dd][Oo][Ww][Nn]|[Aa][Dd][Oo][Cc]|[Rr][Ss][Tt])$'
# A Vale config where Vale finds one by itself; conftest's ini parser drops
# the global keys Packages lives in, so the copy checks read its text (EC-0038).
TEXTS="${TEXTS}|"'^(\.|_)?vale\.ini$'
TEXT_LIMIT=262144

# Files whose size the checks read: Markdown, for the agent context budget.
SIZES='\.md$'

# Files whose SHA-256 the checks read: every file of a vendored copy, which
# its release record lists by digest (DEPS-06, decision 0022).
DIGESTS='^([^/]+/)?contracts/vendor/[^/]+/[^/]+/.+'

# sha256 FILE: the file's SHA-256 in lower-case hex, with whichever tool the
# system has: coreutils, perl's shasum (macOS) or OpenSSL.
sha256() {
  if command -v sha256sum > /dev/null 2>&1; then
    sha256sum -- "$1"
  elif command -v shasum > /dev/null 2>&1; then
    shasum -a 256 -- "$1"
  elif command -v openssl > /dev/null 2>&1; then
    openssl dgst -sha256 -r "$1"
  else
    die "cannot hash ${1}: install sha256sum, shasum or openssl"
  fi | sed 's/[ *].*$//'
}

# matching PATTERN [EXCLUDE]: the repository's files that match PATTERN and
# not EXCLUDE, one per line.
matching() {
  printf '%s\n' "${files}" | grep -E "$1" | grep -Ev "${2:-^$}" || true
}

# preparse PARSER PATTERN [EXCLUDE]: parse each matching file with conftest's PARSER
# into the scratch directory, and add it to the jq arguments being built. A
# file that does not parse is recorded with conftest's reason, not fatal.
preparse() {
  parser=$1
  while IFS= read -r file; do
    [ -n "${file}" ] || continue
    count=$((count + 1))
    if tool conftest aqua:open-policy-agent/conftest "${CONFTEST_VERSION}" parse --combine --parser "${parser}" \
      "${file}" > "${scratch}/parsed.${count}.json" 2> "${scratch}/unparsed.${count}.txt"; then
      printf '%s\n%s\n%s\n' --slurpfile "parsed:${file}" "${scratch}/parsed.${count}.json"
    else
      printf '%s\n%s\n%s\n' --rawfile "unparsed:${file}" "${scratch}/unparsed.${count}.txt"
    fi
  done << EOF
$(matching "$2" "${3:-}")
EOF
}

# The inventory lets the checks see files whose contents are not passed: every
# path, the text, size and digest of the files above, the files parsed before the
# check, and the repository's actual name when it is known. jq writes it, so
# any file name or text is escaped correctly.
write_inventory() {
  count=0
  {
    preparse jsonnet "${JSONNET}"
    preparse dockerfile "${DOCKERFILES}" "${NOT_DOCKERFILES}"
    matching "${TEXTS}" | while IFS= read -r file; do
      if [ -n "${file}" ] && [ "$(wc -c < "${file}")" -le "${TEXT_LIMIT}" ]; then
        printf '%s\n%s\n%s\n' --rawfile "text:${file}" "${file}"
      fi
    done
    matching "${SIZES}" | while IFS= read -r file; do
      if [ -n "${file}" ]; then
        printf '%s\n%s\n%s\n' --arg "size:${file}" "$(wc -c < "${file}" | tr -d ' ')"
      fi
    done
    matching "${DIGESTS}" | while IFS= read -r file; do
      if [ -n "${file}" ]; then
        printf '%s\n%s\n%s\n' --arg "digest:${file}" "$(sha256 "${file}")"
      fi
    done
  } > "${scratch}/arguments"
  set --
  while IFS= read -r argument; do set -- "$@" "${argument}"; done < "${scratch}/arguments"
  printf '%s\n' "${files}" | tool jq aqua:jqlang/jq "${JQ_VERSION}" -Rn --arg name "${actual_name}" "$@" \
    -f "${bundle}/bin/inventory.jq" > "${scratch}/inventory.json"
}

# report JQ_FLAG FORMAT: render conftest's results with bin/report.jq.
report() {
  tool jq aqua:jqlang/jq "${JQ_VERSION}" "$1" --arg format "$2" --arg fail_on "${fail_on}" \
    --argjson colour "${colour:-false}" --slurpfile index "${bundle}/checks/data/index.json" \
    --slurpfile inventory "${scratch}/inventory.json" \
    -f "${bundle}/bin/report.jq" "${scratch}/results.json"
}

check() {
  fail_on=error output=text given='' repository=''
  while [ $# -gt 0 ]; do
    case $1 in
      --fail-on) fail_on=${2:?--fail-on needs error or warning}; shift 2 ;;
      --output | -o) output=${2:?--output needs a format}; shift 2 ;;
      --repository) repository=${2:?--repository needs a name}; shift 2 ;;
      -C) cd -- "${2:?-C needs a directory}"; given=1; shift 2 ;;
      *) usage ;;
    esac
  done
  case ${fail_on} in
    error | warning) ;;
    *) die "--fail-on must be error or warning, not ${fail_on}" ;;
  esac

  find_root
  # Progress goes to stderr, and only to a terminal, so piped output and CI
  # logs carry the report alone.
  if [ -t 2 ]; then
    printf 'conventions %s: checking %s…\n\n' "$(version)" "${root}" >&2
  fi
  scratch=$(mktemp -d)
  trap 'rm -rf "${scratch}"' EXIT
  files=$(list_files)

  actual_name=$(repository_name)
  # Paths are relative to the repository from here on.
  cd "${root}"
  write_inventory

  set --
  while IFS= read -r file; do
    if [ -n "${file}" ]; then set -- "$@" "${file}"; fi
  done << EOF
$(matching "${INPUTS}")
EOF

  set -- -d "${bundle}/checks/data/index.json" "$@"
  if [ -f "${bundle}/checks/data/release.json" ]; then
    set -- -d "${bundle}/checks/data/release.json" "$@"
  fi

  # Any other format is conftest's own (github, sarif, junit, tap, table),
  # passed through as conftest renders it. Its exit status is not the check's:
  # conftest counts every finding, and a staged adoption enforces only some
  # (lib/enforcement.rego), so the status comes from the evaluation below, the
  # same for every format.
  case ${output} in
    text | json) ;;
    *)
      shown=0
      tool conftest aqua:open-policy-agent/conftest "${CONFTEST_VERSION}" test --combine --no-color \
        -o "${output}" -p "${bundle}/checks/rego" "$@" "${scratch}/inventory.json" || shown=$?
      if [ "${shown}" -gt 1 ]; then
        die "conftest could not check the repository (exit ${shown})"
      fi
      ;;
  esac

  status=0
  tool conftest aqua:open-policy-agent/conftest "${CONFTEST_VERSION}" test --combine --no-color \
    -o json -p "${bundle}/checks/rego" "$@" "${scratch}/inventory.json" > "${scratch}/results.json" || status=$?
  # conftest exits 1 for failures and writes its report; anything else, or no
  # report, means it could not check (a parse error, a bad policy).
  if [ "${status}" -gt 1 ] || [ ! -s "${scratch}/results.json" ]; then
    cat "${scratch}/results.json" >&2
    die "conftest could not check the repository (exit ${status})"
  fi

  colour=false
  if [ "${output}" = text ] && [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then
    colour=true
  fi
  case ${output} in
    text) report -r text ;;
    json) report -Sa json ;;
  esac
  if report -e fails > /dev/null; then
    return 1
  fi
}

# Where a repository keeps its Vale config: where Vale finds one by itself,
# or under .config/ (EC-0011). The copy checks read the same files (EC-0038).
VALE_CONFIGS='^((\.|_)?vale\.ini|\.config/(.+/)?vale\.ini)$'

# Files the copy pass hands Vale: the formats it reads natively, and the
# component templates a config maps under [formats]. The config's own globs
# decide which of them are copy.
COPY_FILES='\.(md|mdx|markdown|html?|rst|adoc|txt|astro|ejs|erb|hbs|jinja|liquid|mdoc|njk|svelte|twig|vue)$'

# copy_sections CONFIG: the parts of a repository's Vale config the copy pass
# needs: [formats], and every section that applies MusherCopy or sets one of
# its rules, with BasedOnStyles narrowed to MusherCopy. The adopted packages
# need `vale sync`, so they run in the repository's own Vale call.
copy_sections() {
  awk '
    /^[[:space:]]*[#;]/ { next }
    /^[[:space:]]*\[.*\][[:space:]]*$/ {
      section = $0
      sub(/^[[:space:]]*\[/, "", section)
      sub(/\][[:space:]]*$/, "", section)
      next
    }
    section == "" || index($0, "=") == 0 { next }
    {
      key = substr($0, 1, index($0, "=") - 1)
      gsub(/[[:space:]]/, "", key)
      line = ""
      if (section == "formats") line = $0
      else if (key == "BasedOnStyles" && $0 ~ /[=,][[:space:]]*MusherCopy[[:space:]]*(,|$)/) line = "BasedOnStyles = MusherCopy"
      else if (key ~ /^MusherCopy\./) line = $0
      if (line == "") next
      if (section != shown) { printf "\n[%s]\n", section; shown = section }
      print line
    }
  ' "$1"
}

# vale_on CONFIG PATTERN [PATH...]: run Vale with CONFIG on each PATH, or,
# with none, on every file of the repository that matches PATTERN.
vale_on() {
  vale_config=$1 pattern=$2
  shift 2
  if [ $# -eq 0 ]; then
    while IFS= read -r file; do
      if [ -n "${file}" ]; then set -- "$@" "${file}"; fi
    done << EOF
$(list_files | grep -E "${pattern}" || true)
EOF
    [ $# -gt 0 ] || return 0
  fi
  tool vale aqua:vale-cli/vale "${VALE_VERSION}" --config "${vale_config}" "$@" < /dev/null
}

prose() {
  given=''
  if [ "${1:-}" = -C ]; then
    cd -- "${2:?-C needs a directory}"
    given=1
    shift 2
  fi
  find_root
  cd "${root}"
  scratch=$(mktemp -d)
  trap 'rm -rf "${scratch}"' EXIT
  status=0

  # The terminology the conventions are written in, on every Markdown file.
  cat > "${scratch}/vale.ini" << EOF
StylesPath = ${bundle}/checks/vale
MinAlertLevel = suggestion

[*.md]
BasedOnStyles = MusherConventions
EOF
  vale_on "${scratch}/vale.ini" '\.md$' "$@" || status=$?

  # The copy rules of this release, offline, on the files each of the
  # repository's Vale configs applies MusherCopy to (EC-0038).
  list_files | grep -E "${VALE_CONFIGS}" > "${scratch}/configs" || true
  count=0
  while IFS= read -r config; do
    count=$((count + 1))
    sections=$(copy_sections "${config}")
    case ${sections} in
      *BasedOnStyles*) ;;
      *) continue ;;
    esac
    printf 'StylesPath = %s\nMinAlertLevel = suggestion\n%s\n' "${bundle}/checks/vale" "${sections}" \
      > "${scratch}/copy.${count}.ini"
    vale_on "${scratch}/copy.${count}.ini" "${COPY_FILES}" "$@" || status=$?
  done < "${scratch}/configs"
  return "${status}"
}

# Lint OpenAPI documents with Spectral and the repository's own ruleset,
# which extends the one this release ships (EC-0037, decision 0023). The
# ruleset reaches the shipped file through .conventions/openapi.spectral.yaml,
# a link refreshed on every run so it always names this release; the
# repository ignores .conventions/ (OAS-04). With no FILE, it lints every
# document an `openapi` interface in .repo/outputs.toml covers.
openapi() {
  given='' ruleset=.config/openapi/spectral.yaml
  while [ $# -gt 0 ]; do
    case $1 in
      -C) cd -- "${2:?-C needs a directory}"; given=1; shift 2 ;;
      --ruleset) ruleset=${2:?--ruleset needs a file}; shift 2 ;;
      --) shift; break ;;
      -*) usage ;;
      *) break ;;
    esac
  done
  find_root
  cd "${root}"
  if [ $# -eq 0 ] && [ -f .repo/outputs.toml ]; then
    scratch=$(mktemp -d)
    trap 'rm -rf "${scratch}"' EXIT
    files=$(list_files)
    tool conftest aqua:open-policy-agent/conftest "${CONFTEST_VERSION}" parse .repo/outputs.toml \
      > "${scratch}/outputs.json" || die "cannot read .repo/outputs.toml"
    while IFS= read -r file; do
      if [ -n "${file}" ]; then set -- "$@" "${file}"; fi
    done << EOF
$(printf '%s\n' "${files}" | tool jq aqua:jqlang/jq "${JQ_VERSION}" -Rnr \
      --slurpfile outputs "${scratch}/outputs.json" -f "${bundle}/bin/openapi.jq")
EOF
  fi
  if [ $# -eq 0 ]; then
    echo "conventions: no OpenAPI documents to check: .repo/outputs.toml declares no openapi interface" >&2
    return 0
  fi
  [ -f "${ruleset}" ] ||
    die "${ruleset} does not exist: add a Spectral ruleset that extends ../../.conventions/openapi.spectral.yaml (OAS-02)"
  mkdir -p .conventions
  ln -sfn "${bundle}/checks/openapi/musher.spectral.yaml" .conventions/openapi.spectral.yaml
  tool spectral aqua:stoplightio/spectral "${SPECTRAL_VERSION}" lint --ruleset "${ruleset}" --fail-severity warn "$@"
}

version() {
  release="${bundle}/checks/data/release.json"
  if [ -f "${release}" ]; then
    sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "${release}"
  else
    echo "unreleased (a checkout of musher-dev/engineering-conventions)"
  fi
}

command=${1:-}
[ $# -gt 0 ] && shift
case ${command} in
  check) check "$@" ;;
  prose) prose "$@" ;;
  openapi) openapi "$@" ;;
  version | --version) version ;;
  *) usage ;;
esac
