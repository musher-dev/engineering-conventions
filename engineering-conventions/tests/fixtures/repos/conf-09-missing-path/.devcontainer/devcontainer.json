// A dev container whose editor settings name the configuration.
{
  "name": "Fixture",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": { "ghcr.io/devcontainers/features/git:1": {} },
  "remoteUser": "vscode",
  "forwardPorts": [15432],
  "portsAttributes": { "15432": { "label": "PostgreSQL" } },
  "customizations": {
    "vscode": {
      "settings": {
        "markdownlint.configFile": ".config/markdown/markdownlint.jsonc",
        "vale.valeCLI.config": "${workspaceFolder}/.config/prose/vale.ini"
      }
    }
  }
}
