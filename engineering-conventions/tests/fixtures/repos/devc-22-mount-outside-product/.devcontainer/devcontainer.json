// The product moved to platform-api/, and the build-output volume did not.
{
  "name": "Platform API",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
  },
  "remoteUser": "vscode",
  "forwardPorts": [15432],
  "portsAttributes": { "15432": { "label": "PostgreSQL" } },
  "mounts": [
    "source=musher-${devcontainerId}-gh-config,target=/home/vscode/.config/gh,type=volume",
    "source=musher-${devcontainerId}-target,target=/workspaces/${localWorkspaceFolderBasename}/target,type=volume",
  ],
  "postCreateCommand": ["bash", ".devcontainer/scripts/post-create.sh"],
}
