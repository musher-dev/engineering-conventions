{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "tag-separator": "/",
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore(release): release${component} ${version}",
  "draft": true,
  "force-tag-creation": true,
  "changelog-sections": [
    { "type": "feat", "section": "Additions" },
    { "type": "fix", "section": "Corrections" },
    { "type": "perf", "section": "Performance", "hidden": true },
    { "type": "chore", "section": "Maintenance", "hidden": true }
  ],
  "packages": {
    "schemas/blueprint": { "component": "blueprint" },
    "schemas/listing": { "component": "listing" },
    "schemas/core": { "component": "core", "bump-minor-pre-major": true, "bump-patch-for-minor-pre-major": true }
  }
}
